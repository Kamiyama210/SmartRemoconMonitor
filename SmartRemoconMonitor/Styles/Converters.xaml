<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SmartRemoconMonitor.Converters">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsedConverter" />
    <conv:TrendPointsConverter x:Key="TrendPointsConverter" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <conv:StatusLevelToBrushConverter x:Key="StatusLevelToBrushConverter"
                                      Ok="{StaticResource OkBrush}"
                                      Warning="{StaticResource WarnBrush}"
                                      Error="{StaticResource ErrorBrush}" />

</ResourceDictionary>
