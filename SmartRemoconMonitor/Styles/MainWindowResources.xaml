<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:model="clr-namespace:SmartRemoconMonitor.Models">

    <!-- 画面の枠 -->
    <Style x:Key="TopLineStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="NoticeBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NoticeBrush}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="NoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource NoticeTextBrush}" />
    </Style>

    <Style x:Key="ContentAreaStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <Style x:Key="ContentHostStyle" TargetType="ContentControl">
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- 左のメニュー -->
    <Style x:Key="SidebarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="MenuToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="80" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="MenuListStyle" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <Style x:Key="MenuItemButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="90" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CardCornerRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuIconBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="80" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <Style x:Key="MenuLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
        <Setter Property="Width" Value="200" />
        <Setter Property="Margin" Value="15,0" />
    </Style>

    <DataTemplate x:Key="MainMenuItemTemplate" DataType="{x:Type model:NavigationMenuItem}">
        <Button Style="{StaticResource MenuItemButtonStyle}"
                AutomationProperties.Name="{Binding Label}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding Section}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="IconBorder" Style="{StaticResource MenuIconBorderStyle}">
                    <icon:PackIconMaterial x:Name="MenuIcon" Kind="{Binding Icon}" Style="{StaticResource LargeIconStyle}" />
                </Border>

                <TextBlock Text="{Binding Label}"
                           Style="{StaticResource MenuLabelStyle}"
                           Visibility="{Binding DataContext.IsMenuLabelVisible,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Button>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="IconBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="MenuIcon" Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
