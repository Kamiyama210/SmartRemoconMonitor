<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E9ECEF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F3F5" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DEE2E6" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E7F5FF" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#FFF4E5" />

    <!-- 枠線 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#ADB5BD" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#353B40" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#555555" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#ADB5BD" />
    <SolidColorBrush x:Key="NoticeTextBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />

    <!-- 意味のある色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0056B3" />
    <SolidColorBrush x:Key="TemperatureBrush" Color="#FF5722" />
    <SolidColorBrush x:Key="HumidityBrush" Color="#03A9F4" />
    <SolidColorBrush x:Key="OkBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />

</ResourceDictionary>
