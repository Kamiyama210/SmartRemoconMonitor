<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${specialfolder:folder=LocalApplicationData}/SmartRemoconMonitor/logs/nlog-internal.log">

  <variable name="logDir" value="${specialfolder:folder=LocalApplicationData}/SmartRemoconMonitor/logs" />
  <variable name="layout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${threadid:padding=-3}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=tostring}}" />

  <targets async="true">
    <!-- 書き込み先はユーザー固有の LocalApplicationData 配下。1 日ごと、または 10MB ごとに切り替え、14 個まで残す。 -->
    <target xsi:type="File"
            name="logFile"
            fileName="${logDir}/app.log"
            layout="${layout}"
            encoding="utf-8"
            archiveFileName="${logDir}/archive/app.{#}.log"
            archiveNumbering="Date"
            archiveEvery="Day"
            archiveDateFormat="yyyyMMdd"
            maxArchiveFiles="14"
            archiveAboveSize="10485760"
            keepFileOpen="true"
            concurrentWrites="false" />

    <target xsi:type="Debugger" name="debugger" layout="${layout}" />
  </targets>

  <rules>
    <!-- フレームワーク側の Info 以下のログは出さない -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="logFile,debugger" />
  </rules>
</nlog>
