<UserControl x:Class="SmartRemoconMonitor.Views.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:SmartRemoconMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardPanelViewModel, IsDesignTimeCreatable=False}">

    <Grid Style="{StaticResource DashboardGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="環境ダッシュボード" Style="{StaticResource TitleTextStyle}" />

            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedTextStyle}"
                       Text="{Binding LastUpdatedLocal, StringFormat='最終受信{0:HH:mm:ss}', TargetNullValue='最終受信--:--:--'}" />

            <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}" Text="{Binding DeviceStatusText}" />
            <Ellipse DockPanel.Dock="Right" Style="{StaticResource LampStyle}"
                     Fill="{Binding DeviceStatus, Converter={StaticResource StatusLevelToBrushConverter}}" />

            <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}" Text="{Binding BrokerStatusText}" />
            <Ellipse DockPanel.Dock="Right" Style="{StaticResource LampStyle}"
                     Fill="{Binding BrokerStatus, Converter={StaticResource StatusLevelToBrushConverter}}" />
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="現在の室内環境" Style="{StaticResource HeadingTextStyle}" />

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="温度" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueTextStyle}"
                               Text="{Binding CurrentTemperature, StringFormat={}{0:F1}℃, TargetNullValue='--'}" />
                    <icon:PackIconMaterial DockPanel.Dock="Right" Kind="Thermometer" Style="{StaticResource TemperatureIconStyle}" />
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="湿度" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueTextStyle}"
                               Text="{Binding CurrentHumidity, StringFormat={}{0:F1}％, TargetNullValue='--'}" />
                    <icon:PackIconMaterial DockPanel.Dock="Right" Kind="WaterPercent" Style="{StaticResource HumidityIconStyle}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="エアコンの状態" Style="{StaticResource HeadingTextStyle}" />

                <TextBlock Text="マイコンからの報告を待っています" Style="{StaticResource MutedTextStyle}"
                           Visibility="{Binding HasAcState, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="運転" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PowerText}" Style="{StaticResource ValueTextStyle}" />
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="モード" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ModeText}" Style="{StaticResource ValueTextStyle}" />
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="目標温度" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TargetTemperatureText}" Style="{StaticResource ValueTextStyle}" />
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="風量" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FanSpeedText}" Style="{StaticResource ValueTextStyle}" />
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="風向き" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AirflowText}" Style="{StaticResource ValueTextStyle}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="温度の推移（直近24時間）" Style="{StaticResource HeadingTextStyle}" />
                <Grid x:Name="TemperaturePlot" Style="{StaticResource PlotAreaStyle}">
                    <Path Style="{StaticResource TemperaturePlotStyle}">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource TrendPointsConverter}">
                                <Binding Path="TemperatureTrend.Points" />
                                <Binding ElementName="TemperaturePlot" Path="ActualWidth" />
                                <Binding ElementName="TemperaturePlot" Path="ActualHeight" />
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                    <TextBlock Text="{Binding TemperatureTrend.MaximumLabel}" Style="{StaticResource AxisMaxLabelStyle}" />
                    <TextBlock Text="{Binding TemperatureTrend.MinimumLabel}" Style="{StaticResource AxisMinLabelStyle}" />
                    <TextBlock Text="記録がまだありません" Style="{StaticResource PlotEmptyTextStyle}"
                               Visibility="{Binding TemperatureTrend.HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="湿度の推移（直近24時間）" Style="{StaticResource HeadingTextStyle}" />
                <Grid x:Name="HumidityPlot" Style="{StaticResource PlotAreaStyle}">
                    <Path Style="{StaticResource HumidityPlotStyle}">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource TrendPointsConverter}">
                                <Binding Path="HumidityTrend.Points" />
                                <Binding ElementName="HumidityPlot" Path="ActualWidth" />
                                <Binding ElementName="HumidityPlot" Path="ActualHeight" />
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                    <TextBlock Text="{Binding HumidityTrend.MaximumLabel}" Style="{StaticResource AxisMaxLabelStyle}" />
                    <TextBlock Text="{Binding HumidityTrend.MinimumLabel}" Style="{StaticResource AxisMinLabelStyle}" />
                    <TextBlock Text="記録がまだありません" Style="{StaticResource PlotEmptyTextStyle}"
                               Visibility="{Binding HumidityTrend.HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" />
        </Border>
    </Grid>
</UserControl>
