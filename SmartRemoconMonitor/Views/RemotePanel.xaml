<UserControl x:Class="SmartRemoconMonitor.Views.RemotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:SmartRemoconMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RemotePanelViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer>
        <Border Style="{StaticResource PageBorderStyle}">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <TextBlock Text="リモコン操作" Style="{StaticResource TitleTextStyle}" />

                <TextBlock Text="運転設定" Style="{StaticResource HeadingTextStyle}" />

                <Border Style="{StaticResource FormRowStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="運転モード" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="運転モード" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource FormRowStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="目標温度[℃]" Style="{StaticResource LabelTextStyle}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding DecreaseTemperatureCommand}"
                                    Style="{StaticResource StepperButtonStyle}"
                                    AutomationProperties.Name="目標温度を下げる">
                                <icon:PackIconMaterial Kind="Minus" Style="{StaticResource SmallIconStyle}" />
                            </Button>
                            <TextBlock Text="{Binding TargetTemperature}" Style="{StaticResource StepperValueStyle}" />
                            <Button Command="{Binding IncreaseTemperatureCommand}"
                                    Style="{StaticResource StepperButtonStyle}"
                                    AutomationProperties.Name="目標温度を上げる">
                                <icon:PackIconMaterial Kind="Plus" Style="{StaticResource SmallIconStyle}" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource FormRowStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="風量" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding FanSpeedOptions}" SelectedItem="{Binding SelectedFanSpeed}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="風量" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource FormRowStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="風向き" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding AirflowOptions}" SelectedItem="{Binding SelectedAirflowDirection}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="風向き" />
                    </DockPanel>
                </Border>

                <TextBlock Text="操作" Style="{StaticResource HeadingTextStyle}" />

                <Border Style="{StaticResource FormRowStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="運転設定を送信" Style="{StaticResource LabelTextStyle}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonStyle}"
                                Command="{Binding SendCommandCommand}" Content="送信" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding StatusMessage}" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource FormRowStyle}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="停止操作を送信" Style="{StaticResource LabelTextStyle}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonStyle}"
                                Command="{Binding StopCommand}" Content="送信" />
                    </DockPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
