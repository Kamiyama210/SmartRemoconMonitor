<Application x:Class="SmartRemoconMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartRemoconMonitor.ViewModels"
             xmlns:v="clr-namespace:SmartRemoconMonitor.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Palette.xaml" />
                <ResourceDictionary Source="/Styles/Converters.xaml" />
                <ResourceDictionary Source="/Styles/CommonResources.xaml" />
                <ResourceDictionary Source="/Styles/DashboardResources.xaml" />
                <ResourceDictionary Source="/Styles/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:AppTitleViewModel}">
                <v:AppTitlePanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardPanelViewModel}">
                <v:DashboardPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingPanelViewModel}">
                <v:SettingPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RemotePanelViewModel}">
                <v:RemotePanel />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
